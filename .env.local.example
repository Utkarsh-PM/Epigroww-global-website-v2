# Copy this file to .env.local and fill in values.
# .env.local is gitignored and will never be committed.

# Required — Payload auth/encryption secret. Generate any random 32+ char string.
PAYLOAD_SECRET=replace-with-a-long-random-string

# Optional — Postgres connection string. When set, Payload uses Postgres.
# When unset, Payload falls back to a local SQLite file (./payload-dev.db).
# Example: DATABASE_URL=postgres://user:pass@host:5432/dbname?sslmode=require
# DATABASE_URL=

# Optional — Vercel Blob token for media uploads in production.
# Get from Vercel → Storage → Create Blob Store → connect to project.
# When unset, uploads go to local filesystem (./media folder).
# BLOB_READ_WRITE_TOKEN=
